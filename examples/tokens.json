{
  "tokens": [
    {"name": "WS",    "regex": "( |\t|\n)*", "skip": true},
    {"name": "FLOAT", "regex": "<digit>*.<digit>*", "skip": false},
    {"name": "INT",   "regex": "<digit>*", "skip": false},
    {"name": "IDENT", "regex": "<letter>(<letter>|<digit>|_)*", "skip": false},
    {"name": "OP",    "regex": "==|=|\\+|\\-|\\*|/|<|>", "skip": false}
  ]
}
